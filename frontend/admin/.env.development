# 环境变量配置文件
VITE_ENV=dev

# 端口号
VITE_SERVER_PORT=15999

# 跨域：带前缀的请求由 vite dev server 代理转发到后端，避免直连触发 CORS。
# 注意：后端路由本身就带 /admin/v1 前缀，故代理不做 rewrite，原样转发。
# /events → SSE 独立端口(6601)；/collab → 协同 ws 独立端口(6602，ws:true 升级)。
# 与部署态 nginx 同构：见 scripts/deploy/nginx.conf。
VITE_PROXY='[["/admin", "http://127.0.0.1:6600/"], ["/events", "http://127.0.0.1:6601"], ["/collab", "http://127.0.0.1:6602"]]'

# API 基础地址：设为根路径 "/"（同源，走上方代理）。
# connectrpc 生成的 client path 形如 "admin/v1/captcha"（无前导 /），
# 若 baseURL 为空，axios 会原样返回该 path，被浏览器当作相对当前页面
# 目录解析（如 /auth/login 页面下变成 /auth/admin/v1/captcha），
# 导致路径错位。设 baseURL="/" 使 combineURLs 拼出 "/admin/v1/captcha"
# 绝对路径，由上方 VITE_PROXY 转发到后端，避免 CORS 与路径错位。
VITE_API_URL=/

# SSE地址：同源相对路径，由 VITE_PROXY / 部署态 nginx 转发到 SSE 独立端口。
VITE_SSE_URL=/events

# 协同 ws：同源路径（运行时按 location 绝对化为 ws(s)://host/collab），
# 由 VITE_PROXY / 部署态 nginx 转发到协同独立端口。
VITE_COLLAB_WS_URL=/collab
