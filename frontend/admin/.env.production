# 环境变量配置文件
VITE_ENV=pro

# API 基础地址：同源相对路径，经部署层 nginx 转发到 admin REST（:6600），
# 不再走独立 API 域名（nginx location /admin/ 见 scripts/deploy/nginx.conf）。
# 同 dev 的 combineURLs 缘由（生成 client path 无前导 /），保持根路径 "/"。
VITE_API_URL=/

# SSE地址：同源相对路径，nginx location = /events 转发到 admin SSE（:6601）。
VITE_SSE_URL=/events

# 协同 ws：同源路径（运行时按 location 绝对化为 ws(s)://host/collab），
# nginx location /collab 转发到 admin 协同 ws（:6602）。
# 注意：后端 COLLAB_ALLOWED_ORIGINS 须含 admin 站点来源。
VITE_COLLAB_WS_URL=/collab
