# NTP服务器地址
NTP_HOST="time.google.com"

# API基本链接地址：C 端站点域（同站 nginx 转发 /app/v1/... 到 app 服务，
# 见 frontend/app/react/scripts/deploy/nginx.conf），不再走独立 API 域名。
# flutter 非浏览器无法相对路径，填本端站点域（与后端 CORS 白名单一致）。
API_BASE_URL="https://flutter.cms.gowind.cloud"
# SSE基本链接地址：同站 nginx location = /events 转发到 app SSE（:6701）。
SSE_URL="https://flutter.cms.gowind.cloud/events"

# 连接超时时间
CONNECTION_TIMEOUT=3000
# 接受数据等待超时时间
RECEIVE_TIMEOUT=3000

# IOS应用ID
IOS_APP_ID=

ENABLE_IN_APP_LOCALHOST_SERVER=false

# Sentry异常监控DSN
SENTRY_DSN="https://ingest.sentry.io/"

AES_KEY="f51d66a73d8a0927"
