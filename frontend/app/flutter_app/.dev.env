# NTP服务器地址
NTP_HOST="time.google.com"

# API基本链接地址（开发态直连本地 app 服务，不走部署层 nginx）
API_BASE_URL="http://localhost:6700"
# SSE基本链接地址
SSE_URL="http://localhost:6701/events"

# 连接超时时间
CONNECTION_TIMEOUT=3000
# 接受数据等待超时时间
RECEIVE_TIMEOUT=3000

# IOS应用ID
IOS_APP_ID=

ENABLE_IN_APP_LOCALHOST_SERVER=false

# Sentry异常监控DSN
SENTRY_DSN="https://ingest.sentry.io/"

AES_KEY="f51d66a73d8a0927"
