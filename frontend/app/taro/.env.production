# TARO_APP_ID="生产环境下的小程序 AppID"

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
TARO_APP_NAMESPACE=gowind-cms-app

# 应用的访问路径
TARO_APP_PUBLIC_PATH=/

# AES加密密钥
TARO_APP_AES_KEY="f51d66a73d8a0927"

# API 接口地址：C 端站点域（同站 nginx 转发 /app/v1/... 到 app 服务，
# 见 frontend/app/react/scripts/deploy/nginx.conf），不再走独立 API 域名。
# 小程序无法用相对路径，且微信合法域名要求 https，故填本端站点域完整地址
# （taro 部署子域，与后端 CORS 白名单一致）；H5 同站部署时请求同源由 nginx 转发。
TARO_APP_API_BASE_URL=https://taro.cms.gowind.cloud

# 是否启用 Mock 数据
TARO_ENABLE_MOCK=false

# 应用标题
TARO_APP_TITLE='GoWind Content Hub'

# 应用描述
TARO_APP_DESCRIPTION='Headless Content Hub, everywhere'

# 默认语言
TARO_DEFAULT_LOCALE=zh-CN

# 默认时区
TARO_DEFAULT_TIMEZONE=Asia/Shanghai
